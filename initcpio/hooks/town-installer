#!/usr/bin/ash

# Get parent disk of a partition device
# /dev/sda1 → /dev/sda, /dev/nvme0n1p1 → /dev/nvme0n1, /dev/vda1 → /dev/vda
_parent_disk() {
    case "$1" in
        /dev/nvme*) echo "${1%p[0-9]*}" ;;
        *) echo "${1%%[0-9]*}" ;;
    esac
}

mount_town_os() {
    local boot_disk=$(_parent_disk "$root")

    # Register all btrfs members first. With btrfs_raid_mode: native the
    # /town-os filesystem spans every data disk as a single multi-device btrfs,
    # and a multi-device btrfs cannot be mounted from one member until the
    # kernel knows about all of them. The initrd has no btrfs udev rules, so
    # nothing scans automatically — without this, the mount below fails with
    # ENOENT and we wrongly re-launch the installer on every boot.
    btrfs device scan >/dev/null 2>&1

    # Scan for a btrfs partition with Town OS overlay dirs (skip boot device)
    for dev in /dev/sd*1 /dev/nvme*p1 /dev/vd*1; do
        [ -b "$dev" ] || continue
        [ "$(_parent_disk "$dev")" = "$boot_disk" ] && continue
        if mount -t btrfs "$dev" /town-os 2>/dev/null; then
            if [ -d /town-os/etc ] || [ -d /town-os/var ]; then
                return 0
            fi
            umount /town-os
        fi
    done
    return 1
}

prepare_networking() {
    # Seed a minimal /etc so ttyforce has somewhere to write its bootstrap
    # resolv.conf fallback. The dhcpcd run/lease directories are created by
    # ttyforce itself (initrd_ops::network::prepare_dhcpcd_dirs) right before it
    # launches dhcpcd, so the lease (and its DHCP-offered DNS) is persisted and
    # readable — keeping that ownership in ttyforce, not split across this hook.
    mkdir -p /etc /etc/systemd/network
    cat > /etc/resolv.conf <<RESOLV
nameserver 8.8.8.8
nameserver 8.8.4.4
nameserver 1.1.1.1
RESOLV
}

# Wait (bounded) for a path to appear. Returns 1 on timeout; callers log and
# carry on rather than hanging the boot forever on missing hardware.
_wait_for_path() {
    _path="$1"; _secs="$2"
    _i=0
    # Whole-second steps: the initrd's busybox `sleep` cannot be relied on to
    # accept a fractional argument. The path is tested BEFORE the first sleep, so
    # hardware that is already up costs nothing.
    while [ ! -e "$_path" ]; do
        _i=$((_i + 1))
        [ "$_i" -gt "$_secs" ] && return 1
        sleep 1
    done
    return 0
}

# Wait for the LOCAL console hardware when the installer is going to run on a
# virtual terminal rather than a serial line — i.e. when the machine's own screen
# and buttons are the only interface (the Anbernic RG35XX boots exactly this way:
# console=tty0, no serial console at all).
#
# `udevadm settle` above is not enough for either half. It waits for the events
# already queued, but a DRM panel that returns -EPROBE_DEFER — which is the norm
# for this board, where the panel needs its regulators, the SPI init bus and the
# PWM backlight to come up first — is retried AFTER settle returns. Launching
# ttyforce in that window gives it a tty0 with no framebuffer: it draws into
# nothing and exits, and the boot ends with an unprovisioned machine in front of
# a user staring at a black screen.
#
# The same applies to input: ttyforce enumerates gamepads through gilrs once at
# startup, so a pad whose evdev node has not appeared yet is simply not there.
wait_for_local_console() {
    if ! _wait_for_path /sys/class/graphics/fb0 15; then
        echo "town-installer: no framebuffer after 15s — the installer may have nothing to draw on" > /dev/kmsg
    else
        echo "town-installer: framebuffer ready" > /dev/kmsg
    fi

    # Any event node will do; we only need udev to have created the input
    # devices before gilrs/evdev enumerate them.
    if ! _wait_for_path /dev/input/event0 5; then
        echo "town-installer: no input devices after 5s — buttons/keyboard may not work" > /dev/kmsg
    fi
}

run_hook() {
    # Wait for udev to finish discovering all block devices
    msg ":: town-installer: waiting for udev..."
    udevadm settle --timeout=10

    # Skip if /town-os is already provisioned (btrfs exists on a data disk)
    mkdir -p /town-os
    echo "town-installer: checking for existing btrfs..." > /dev/kmsg
    if mount_town_os; then
        echo "town-installer: SKIPPING - btrfs found, already provisioned" > /dev/kmsg
        umount /town-os
        return
    fi
    echo "town-installer: no btrfs found, will launch ttyforce" > /dev/kmsg

    # Prepare directories for ttyforce's --initrd networking (dhcpcd)
    prepare_networking

    msg ":: Launching Town OS installer..."

    # Determine which TTY to direct ttyforce at based on the kernel console= params.
    # The last console= parameter is the primary console (/dev/console).
    export TERM=linux
    TTY_ARGS=""
    last_console=$(awk 'BEGIN{RS=" "} /^console=/{c=$0} END{sub(/^console=/,"",c); sub(/,.*/,"",c); print c}' /proc/cmdline)
    if [ -n "$last_console" ] && [ -e "/dev/$last_console" ]; then
        TTY_ARGS="--tty /dev/$last_console"
    fi

    # A virtual terminal means the local screen and local input are the
    # interface, so wait for both to exist before handing over (see above). A
    # serial console needs neither.
    case "$last_console" in
        tty[0-9]*) wait_for_local_console ;;
    esac

    /usr/bin/ttyforce initrd --etc-prefix /town-os/etc/overlays/root --ssh-user root,status $TTY_ARGS
    echo "town-installer: ttyforce exited with code $?" > /dev/kmsg

    # ttyforce unmounts /town-os before returning — re-mount to persist config
    mkdir -p /town-os
    if mount -t btrfs /town-os 2>/dev/null || mount_town_os; then
        msg ":: Persisting network config to /town-os..."

        # Create etc/var overlay directories on persistent storage
        mkdir -p /town-os/etc/overlays/root /town-os/etc/overlays/work
        mkdir -p /town-os/var/overlays/root /town-os/var/overlays/work

        # Mask the catch-all 10-ethernet.network so only the selected interface is active
        mkdir -p /town-os/etc/overlays/root/systemd/network
        : > /town-os/etc/overlays/root/systemd/network/10-ethernet.network

        umount /town-os
    fi
}
