# Kernel config fragment for the Anbernic RG35XX Pro / Allwinner H700 build.
#
# scripts/build-kernel-rg35xx.sh applies this on top of the kernel's own arm64
# `defconfig` via scripts/kconfig/merge_config.sh, then runs `olddefconfig`.
#
# WHY A FRAGMENT AND NOT A WHOLE .config: a checked-in .config rots the moment
# the kernel pin moves — it carries thousands of symbols whose defaults changed,
# and diffing it tells you nothing about intent. A fragment states only the
# decisions this board actually makes, so every line here is a claim someone
# made on purpose and `olddefconfig` still resolves everything else against the
# kernel we are really building.
#
# WHY THE BASE IS STILL arm64 defconfig: it is maintained in-tree for exactly
# this kernel version. Arch Linux ARM's config tracks a much newer kernel than
# this patch set applies to, so olddefconfig against it would silently default
# hundreds of symbols that moved or were renamed in between.
#
# WHAT THIS FRAGMENT IS MOSTLY FOR: arm64 defconfig is the MULTIPLATFORM config
# — it turns on essentially every ARM64 vendor's driver tree, mostly as modules.
# Building it emulated (make image TARGET=rg35xxpro on an x86 host runs the whole
# compile under TCG) meant hours spent compiling MediaTek clock drivers, Tegra
# audio, NVIDIA host1x, UBIFS and NFC for a handheld that has none of it. The
# "not set" blocks below prune the tree to this board; the enable blocks are the
# things Town OS and this board genuinely need, asserted explicitly.
#
# ANY SYMBOL HERE THAT DOES NOT EXIST in the kernel being built is silently
# dropped by olddefconfig — harmless, and why this list can name platforms from
# several kernel versions. The reverse (something we need being dropped) is what
# the MUST_HAVE check in build-kernel-rg35xx.sh exists to catch, so add anything
# load-bearing there as well as here.

# =============================================================================
# Platforms: this is an Allwinner box and nothing else
# =============================================================================
# The single biggest win. Most vendor drivers are gated on `depends on ARCH_x ||
# COMPILE_TEST`, and defconfig does not set COMPILE_TEST, so switching a platform
# off takes its clocks, pinctrl, SoC glue, PHYs, thermal, DRM and audio with it.
CONFIG_ARCH_SUNXI=y
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
# CONFIG_ARCH_SUNPLUS is not set

# =============================================================================
# Subsystems this appliance has no use for
# =============================================================================
# Town OS is a headless network appliance that happens to have a screen for its
# installer. It never plays audio, pairs a device, captures video, or talks to
# raw flash. ROCKNIX needs all of this; we are not ROCKNIX.
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_BT is not set
# CONFIG_NFC is not set
# CONFIG_CAN is not set
# CONFIG_HAMRADIO is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_INFINIBAND is not set
# CONFIG_STAGING is not set
# CONFIG_MTD is not set
# CONFIG_HWMON is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_USB_SERIAL is not set
# CONFIG_WWAN is not set
# CONFIG_ACCEL is not set
# CONFIG_RAPIDIO is not set
# CONFIG_THUNDERBOLT is not set
# CONFIG_MEMSTICK is not set
# CONFIG_ARM_SDE_INTERFACE is not set
# KVM: this box never hosts virtual machines, and the QEMU smoke test does not
# nest. arch/arm64/kvm is a lot of code to compile for nobody.
# CONFIG_VIRTUALIZATION is not set
# CONFIG_XEN is not set
# 32-bit ARM userspace: Town OS userspace and every container image it pulls are
# aarch64. (ROCKNIX keeps this for 32-bit emulator cores; we run none.)
# CONFIG_COMPAT is not set

# =============================================================================
# Filesystems: only what actually gets mounted
# =============================================================================
# The image mounts squashfs (root), btrfs (/town-os), ext4 (data partition),
# vfat (boot partition), plus overlay/tmpfs/proc/sys and fuse for podman.
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_EROFS_FS is not set
# CONFIG_EXFAT_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_HFSPLUS_FS is not set
# CONFIG_ZONEFS_FS is not set
# CONFIG_ECRYPT_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_SMB_SERVER is not set
# CONFIG_CEPH_FS is not set
# CONFIG_9P_FS is not set
# CONFIG_AFS_FS is not set
# CONFIG_CODA_FS is not set
# CONFIG_ORANGEFS_FS is not set

# =============================================================================
# Network protocols: the container/WireGuard data path, nothing exotic
# =============================================================================
# CONFIG_IP_DCCP is not set
# CONFIG_IP_SCTP is not set
# CONFIG_TIPC is not set
# CONFIG_RDS is not set
# CONFIG_ATM is not set
# CONFIG_X25 is not set
# CONFIG_LAPB is not set
# CONFIG_PHONET is not set
# CONFIG_IEEE802154 is not set
# CONFIG_MAC802154 is not set
# CONFIG_6LOWPAN is not set
# CONFIG_BATMAN_ADV is not set
# CONFIG_AF_RXRPC is not set
# CONFIG_NET_9P is not set
# CONFIG_L2TP is not set

# =============================================================================
# Ethernet: this board has no Ethernet port
# =============================================================================
# CONFIG_ETHERNET is the menu gating ALL of drivers/net/ethernet — one symbol
# instead of ~70 NET_VENDOR_* lines. USB Ethernet (drivers/net/usb, under
# USB_NET_DRIVERS) and virtio_net are NOT under it and are unaffected; they are
# how this box actually gets a wire, and are enabled further down.
# CONFIG_ETHERNET is not set

# =============================================================================
# WiFi: Realtek only (the onboard RTL8821CS on SDIO)
# =============================================================================
# WLAN itself stays on — it is the board's primary NIC. Only the other vendors
# go, and they are most of drivers/net/wireless.
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_CISCO is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set

# =============================================================================
# GPU: the Allwinner display engine, plus virtio-gpu for the QEMU smoke test
# =============================================================================
# No 3D anywhere in Town OS — the panel exists to show a TUI installer. That
# includes the H700's own Mali (LIMA/PANFROST): the display controller is what
# lights the screen, the GPU is what nobody asks to render.
# CONFIG_DRM_LIMA is not set
# CONFIG_DRM_PANFROST is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_MSM is not set
# CONFIG_DRM_TEGRA is not set
# CONFIG_DRM_ROCKCHIP is not set
# CONFIG_DRM_MESON is not set
# CONFIG_DRM_ETNAVIV is not set
# CONFIG_DRM_V3D is not set
# CONFIG_DRM_VC4 is not set
# CONFIG_DRM_EXYNOS is not set
# CONFIG_DRM_MEDIATEK is not set
# CONFIG_DRM_STM is not set
# CONFIG_DRM_IMX is not set
# CONFIG_DRM_HISI_HIBMC is not set
# CONFIG_DRM_HISI_KIRIN is not set
# CONFIG_DRM_KOMEDA is not set
# CONFIG_DRM_MALI_DISPLAY is not set
# CONFIG_DRM_PL111 is not set
# CONFIG_DRM_AST is not set
# CONFIG_DRM_MGAG200 is not set
# CONFIG_DRM_QXL is not set
# CONFIG_DRM_VMWGFX is not set
# CONFIG_DRM_UDL is not set
# CONFIG_DRM_VKMS is not set

# =============================================================================
# Storage controllers: SD, USB, and AHCI (for the QEMU test rig only)
# =============================================================================
# SATA_AHCI IS LOAD-BEARING and not for the hardware: make/qemu.sh attaches the
# four data disks as `-device ahci` + `ide-hd`, and those disks are what ttyforce
# provisions the persistent btrfs onto. Drop AHCI and `make qemu-usb
# TARGET=rg35xxpro` boots to an installer with nothing to install to. The real
# board has no SATA at all.
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y
# Legacy PATA/SFF controllers exist on neither the board nor the test rig.
# CONFIG_ATA_SFF is not set
# All the enterprise HBAs (megaraid, mpt3sas, qla2xxx, lpfc, ...). sd/sr stay.
# CONFIG_SCSI_LOWLEVEL is not set

# =============================================================================
# Root filesystem: read-only squashfs (zlib — see install.sh) + tmpfs overlay,
# btrfs for /town-os, ext4 for the data partition, vfat for the boot partition.
# =============================================================================
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_OVERLAY_FS=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_FUSE_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_AUTOFS_FS=y

# =============================================================================
# systemd/podman substrate: namespaces, cgroups, seccomp, devtmpfs, xattrs
# =============================================================================
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FANOTIFY=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_POSIX_MQUEUE=y

# =============================================================================
# Networking: the container/WireGuard data path plus nftables
# =============================================================================
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_WIREGUARD=y
CONFIG_IPV6=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_NAT=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_IP_NF_IPTABLES=y
# NO LEGACY iptables TABLES. The `nat` table and its MASQUERADE target now live
# behind CONFIG_IP_NF_IPTABLES_LEGACY (upstream split legacy ip_tables out from
# the xtables core), whose own help text says it "is not needed if you are using
# iptables over nftables (iptables-nft)" — which is the only iptables Arch ships.
# Podman's netavark programs nftables directly anyway, so the masquerade this box
# actually installs comes from NFT_MASQ/NF_NAT_MASQUERADE above. Asking for
# CONFIG_IP_NF_NAT here without the LEGACY symbol was a silent no-op.
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VLAN_8021Q=y

# =============================================================================
# Storage + USB on this board: the SD host, USB host/OTG, USB mass storage
# (the persistent btrfs lives on USB — mainline enables no second card slot)
# =============================================================================
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SUNXI=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_PWRSEQ_EMMC=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
# xHCI for the QEMU test rig (qemu-xhci carries the boot stick and USB HID).
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y

# =============================================================================
# Input
# =============================================================================
# The pad itself is the out-of-tree rocknix-singleadc-joypad module built by
# build-kernel-rg35xx.sh; everything it stands on is built IN, because it is the
# board's only input device and the installer needs it in the initrd:
#   INPUT_POLLDEV     the polled-input API it registers with (EXTRA_PATCHES).
#   INPUT_FF_MEMLESS  it references input_ff_create_memless() unconditionally,
#                     so the symbol must exist even though this board has no
#                     rumble motor — otherwise the module fails to load.
#   IIO/SUN20I_GPADC  the ADC the analog sticks are read through, behind the
#                     GPIO-selected mux the driver walks.
#   KEYBOARD_ADC      not for any button on this board: adc-keys is where the
#                     patched kernel DEFINES and exports joypad_input_g, the
#                     symbol the joypad module links against. Built out, the
#                     module cannot load.
#   KEYBOARD_GPIO     still needed: the volume buttons stay a gpio-keys node.
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
# HIDRAW is not a driver: HID_LOGITECH_DJ (below) `depends on` it, so without it
# the unifying-receiver line is silently dropped and a Logitech pad plugged into
# the OTG port never enumerates its paired devices.
CONFIG_HIDRAW=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_POLLDEV=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_SUN20I_GPADC=y
CONFIG_KEYBOARD_ADC=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_HID_SONY=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_STEAM=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m

# =============================================================================
# THE POINT OF THIS BUILD: the display
# =============================================================================
# DE33 mixer + TCON + the generic MIPI-DPI/SPI panel driver (DRM_PANEL_MIPI,
# added by the patch set), the PWM driver and PWM backlight the panel needs to be
# visible, and the fbdev emulation + framebuffer console that turn it into
# /dev/tty0.
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
# NOT DRM_SUN4I_BACKEND: that is the DE1 backend of the 32-bit A10-era SoCs and
# `depends on ARM || COMPILE_TEST`, so on arm64 the line can never take. The H700
# feeds its TCON from the DE33 mixer — DRM_SUN8I_MIXER, right below, is the one
# that matters here.
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_MIPI=y
CONFIG_DRM_PANEL_BRIDGE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_PWM=y
CONFIG_PWM_SUN20I=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_SPI=y
CONFIG_SPI_GPIO=y
CONFIG_SPI_SUN6I=y
CONFIG_REGMAP_SPI=y

# =============================================================================
# Board plumbing: PMIC/regulators the panel, WiFi and SD rails hang off, the
# 8250 UART that is the serial console, thermal/watchdog, SRAM controller
# =============================================================================
CONFIG_MFD_AXP20X=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_AXP20X_POWER=y
CONFIG_SUNXI_SRAM=y
CONFIG_SUN8I_THERMAL=y
CONFIG_SUNXI_WATCHDOG=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SUN50I_H616_CCU=y
CONFIG_SUN50I_H6_R_CCU=y
CONFIG_SUN8I_DE2_CCU=y
CONFIG_RTC_DRV_SUN6I=y
CONFIG_I2C_MV64XXX=y
CONFIG_NVMEM_SUNXI_SID=y

# =============================================================================
# WiFi: the RTL8821CS on SDIO, its firmware loader, and rfkill
# =============================================================================
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_CORE=m
CONFIG_RTW88_SDIO=m
CONFIG_RTW88_8821C=m
CONFIG_RTW88_8821CS=m
CONFIG_RFKILL=m
# CFG80211 AND MAC80211 ARE DELIBERATELY MODULAR, and asking for =y here does not
# work anyway — two independent reasons, both worth knowing before someone
# "fixes" this:
#   1. `config CFG80211 depends on RFKILL || !RFKILL`, which caps CFG80211 at
#      RFKILL's value. RFKILL is m (above), so CFG80211 resolves to m and
#      MAC80211 follows it. A =y line here is a silent no-op.
#   2. Building them in would BREAK THE BUILD at verify_initrd. mkinitcpio pulls
#      a module's firmware by reading MODULE_FIRMWARE out of the .ko, and
#      regulatory.db is declared by cfg80211 (net/wireless/reg.c) — nothing
#      else. Built in, there is no .ko to read, the regdb never lands in the
#      initrd, and scripts/configure.sh's VERIFY_FIRMWARE check fails. Modular is
#      also what configure.sh's WANT_MODULES already lists them as.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_FW_LOADER=y
CONFIG_CFG80211_CRDA_SUPPORT=y
# Wireless extensions compat, for ONE caller: ttyforce's initrd wifi scan falls
# back to `iwlist <iface> scan` when `iw dev <iface> scan` fails
# (src/engine/initrd_ops/network.rs), and iwlist is a wireless-extensions tool
# that does nothing without this symbol. defconfig does not set it, so on this
# board the fallback was dead code — on the one target whose only NIC is wifi and
# whose only console is the panel, i.e. exactly where a failed scan is hardest to
# recover from. The initrd already carries the iwlist binary
# (initcpio/install/town-installer), and that hook is shared with every other
# image, so dropping it there to match would take a WORKING fallback away from
# the PC/rpi builds. Enabling a few KB of compat code in a cfg80211 we are
# already building is the cheaper side of that trade.
CONFIG_CFG80211_WEXT=y

# =============================================================================
# USB Ethernet: the dependable way to get this box online (no Ethernet port)
# =============================================================================
CONFIG_NETDEVICES=y
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_SMSC95XX=m

# =============================================================================
# virtio, purely so `make qemu-usb TARGET=rg35xxpro` can boot this exact kernel
# under QEMU 'virt' and show the installer on an emulated screen — the closest
# thing to a test rig this target has. Costs nothing on real hardware.
# =============================================================================
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_VIRTIO_INPUT=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y

# =============================================================================
# Firmware interfaces neither the board nor the test rig has
# =============================================================================
# ACPI: an Allwinner box is device-tree only, and so is the QEMU smoke test —
# `make qemu-usb TARGET=rg35xxpro` direct-kernel-boots (-kernel/-initrd) with no
# pflash at all, so 'virt' hands the kernel a DT too. Nothing here ever parses a
# table, and APEI/HMAT/memory-hotplug pull in a lot of code for nobody.
# CONFIG_ACPI is not set
# CONFIG_ACPI_APEI is not set
# CONFIG_ACPI_HMAT is not set
# CONFIG_ACPI_HOTPLUG_MEMORY is not set
# CONFIG_ACPI_CPPC_CPUFREQ is not set
# EFI: there is no UEFI anywhere on this target. The real board is booted by
# U-Boot's syslinux/extlinux bootmeth, which uses `booti` — not the EFI boot
# manager — and the QEMU path (above) skips firmware entirely. No stub, no
# runtime services, no varstore.
# CONFIG_EFI is not set
# CONFIG_EFI_CAPSULE_LOADER is not set
# CONFIG_EFIVAR_FS is not set
# CONFIG_FB_EFI is not set
# CONFIG_EFI_PARTITION IS A DIFFERENT SYMBOL AND MUST STAY ON. It is GPT support
# in block/partitions/efi.c — "EFI" only because GPT came from the EFI spec — and
# it is `default y` independent of CONFIG_EFI. This image is GPT (that is the
# whole reason U-Boot is written at 128 KiB instead of 8 KiB), so losing it means
# a kernel that cannot see the data partition and a root= that never resolves.
# It is asserted in MUST_HAVE for exactly that reason.
CONFIG_EFI_PARTITION=y
# ARM firmware protocols the H700 does not implement (it has no SCP running
# SCMI/SCPI — that is exactly why the U-Boot build passes SCP=/dev/null).
# CONFIG_ARM_SCMI_PROTOCOL is not set
# CONFIG_ARM_SCPI_PROTOCOL is not set
# CONFIG_GOOGLE_FIRMWARE is not set
# No TPM, no BMC, no ECC-reporting memory controller on a handheld.
# CONFIG_TCG_TPM is not set
# CONFIG_IPMI_HANDLER is not set
# CONFIG_EDAC is not set

# =============================================================================
# Kernel features an appliance with a read-only root never reaches
# =============================================================================
# One SoC, one memory node: NUMA and memory hotplug describe a machine this is
# not, and NUMA_BALANCING costs scheduler work on every box that enables it.
# CONFIG_NUMA is not set
# CONFIG_NUMA_BALANCING is not set
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_MEMORY_HOTREMOVE is not set
# CONFIG_KSM is not set
# There is no swap and no writable root, so there is nowhere to write a
# hibernation image; and nothing on this box kexecs — sledgehammer reboots.
# CONFIG_HIBERNATION is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CRASH_DUMP is not set
# Town OS runs no auditd and sets no quotas; BFQ is a desktop-latency scheduler
# for a box whose root is squashfs (mq-deadline stays and is the default).
# CONFIG_AUDIT is not set
# CONFIG_QUOTA is not set
# CONFIG_IOSCHED_BFQ is not set
# CONFIG_PROFILING is not set
# IKCONFIG is deliberately KEPT (/proc/config.gz is the only way to inspect what
# a board that will not boot was actually built with).

# =============================================================================
# IOMMU and device passthrough
# =============================================================================
# The H700 has no SMMU and QEMU 'virt' is launched without one; nothing on this
# box assigns a device to a guest (VIRTUALIZATION is already off above).
# CONFIG_ARM_SMMU is not set
# CONFIG_ARM_SMMU_V3 is not set
# CONFIG_ARM_SMMU_V3_PMU is not set
# CONFIG_VFIO is not set

# =============================================================================
# Storage: stacking layers and controllers that are on neither the board nor
# the QEMU rig
# =============================================================================
# NO DEVICE-MAPPER AND NO MD RAID: ttyforce offers exactly three storage layouts
# — Single, BtrfsRaid1, BtrfsRaid5 (src/disk/raid.rs) — and implements all of
# them with `mkfs.btrfs -d/-m`. It never invokes mdadm, LVM or cryptsetup, and
# podman uses the native btrfs driver rather than devicemapper, so dm-mod and
# md-mod are compiled for nobody. (btrfs qgroups are unrelated to CONFIG_QUOTA
# above and to dm.)
# CONFIG_MD is not set
# CONFIG_BLK_DEV_MD is not set
# CONFIG_BLK_DEV_DM is not set
# CONFIG_DM_MIRROR is not set
# CONFIG_DM_ZERO is not set
# UFS is phone/laptop storage; this board boots from SD and stores on USB.
# CONFIG_SCSI_UFSHCD is not set
# CONFIG_BLK_INLINE_ENCRYPTION is not set
# The H700 has no PCIe at all, and the QEMU data disks are attached as AHCI.
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_BLK_DEV_NBD is not set
# SATA_AHCI (PCI) is kept above for the QEMU rig; these platform/vendor AHCI
# and legacy SATA controllers exist on neither.
# CONFIG_SATA_AHCI_PLATFORM is not set
# CONFIG_AHCI_DWC is not set
# CONFIG_AHCI_CEVA is not set
# CONFIG_SATA_SIL24 is not set
# The board's card host is sunxi-mmc (MMC_SUNXI above). MMC_SDHCI is the parent
# symbol for the whole SDHCI family, so one line drops ~15 host drivers.
# CONFIG_MMC_SDHCI is not set
# CONFIG_MMC_ARMMMCI is not set
# CONFIG_MMC_SPI is not set
# CONFIG_MMC_DW is not set
# CONFIG_EEPROM_AT24 is not set
# CONFIG_EEPROM_AT25 is not set

# =============================================================================
# USB: controllers and roles this board does not have
# =============================================================================
# The H700's USB is MUSB (OTG) plus EHCI/OHCI, all enabled above; the QEMU rig
# adds xHCI. Every other controller family in defconfig is someone else's SoC.
# CONFIG_USB_DWC3 is not set
# CONFIG_USB_DWC2 is not set
# CONFIG_USB_CHIPIDEA is not set
# CONFIG_USB_ISP1760 is not set
# CONFIG_USB_MTU3 is not set
# CONFIG_USB_CDNS_SUPPORT is not set
# CONFIG_USB_CDNS3 is not set
# CONFIG_USB_RENESAS_USBHS is not set
# CONFIG_USB_XHCI_PCI_RENESAS is not set
# CONFIG_USB_XHCI_SIDEBAND is not set
# CONFIG_USB_HSIC_USB3503 is not set
# CONFIG_USB_ONBOARD_DEV is not set
# CONFIG_USB_ACM is not set
# USB_GADGET ITSELF STAYS — USB_MUSB_DUAL_ROLE selects it, and dual role is what
# lets the OTG port work as a host. What goes is every gadget FUNCTION and every
# foreign UDC: Town OS is never the peripheral, so it never presents an ACM,
# ethernet or mass-storage interface to anything.
# CONFIG_USB_CONFIGFS is not set
# CONFIG_USB_MASS_STORAGE is not set
# CONFIG_USB_RENESAS_USBHS_UDC is not set
# CONFIG_USB_RENESAS_USB3 is not set
# CONFIG_USB_TEGRA_XUDC is not set
# USB-C power delivery / alt-mode: the port is driven as plain OTG through
# phy-sun4i-usb, and no RG35XX device tree has a tcpm or ucsi node. This drops
# ~25 TCPC/mux/alt-mode drivers.
# CONFIG_TYPEC is not set
# USB Ethernet adapters other than the ones configure.sh actually bundles
# (r8152, asix, ax88179_178a, cdc_ether/ncm, rndis, smsc95xx — all enabled
# below). These are the leftovers defconfig turns on.
# CONFIG_USB_PEGASUS is not set
# CONFIG_USB_RTL8150 is not set
# CONFIG_USB_LAN78XX is not set
# CONFIG_USB_NET_DM9601 is not set
# CONFIG_USB_NET_SR9800 is not set
# CONFIG_USB_NET_SMSC75XX is not set
# CONFIG_USB_NET_PLUSB is not set
# CONFIG_USB_NET_MCS7830 is not set

# =============================================================================
# DRM: other people's panels, bridges and GPUs
# =============================================================================
# THE ARCH_* PRUNING ABOVE DOES NOT REACH THESE. Panel and bridge drivers hang
# off DRM_PANEL / DRM_BRIDGE and depend on OF/I2C/DSI — not on any ARCH_ symbol
# — so enabling DRM at all keeps every one of them compiling. This board has
# exactly one panel (panel-mipi-dpi-spi, DRM_PANEL_MIPI above, driven over DPI
# from the TCON) and no bridge chip, no DSI link and no HDMI output.
# CONFIG_DRM_PANEL_SIMPLE is not set
# CONFIG_DRM_PANEL_EDP is not set
# CONFIG_DRM_PANEL_LVDS is not set
# CONFIG_DRM_PANEL_SUMMIT is not set
# CONFIG_DRM_PANEL_BOE_TV101WUM_NL6 is not set
# CONFIG_DRM_PANEL_HIMAX_HX8279 is not set
# CONFIG_DRM_PANEL_HIMAX_HX83112A is not set
# CONFIG_DRM_PANEL_HIMAX_HX83112B is not set
# CONFIG_DRM_PANEL_ILITEK_ILI9882T is not set
# CONFIG_DRM_PANEL_KHADAS_TS050 is not set
# CONFIG_DRM_PANEL_MANTIX_MLAF057WE51 is not set
# CONFIG_DRM_PANEL_NOVATEK_NT36672A is not set
# CONFIG_DRM_PANEL_NOVATEK_NT36672E is not set
# CONFIG_DRM_PANEL_NOVATEK_NT37801 is not set
# CONFIG_DRM_PANEL_RAYDIUM_RM67191 is not set
# CONFIG_DRM_PANEL_RAYDIUM_RM692E5 is not set
# CONFIG_DRM_PANEL_SAMSUNG_ATNA33XC20 is not set
# CONFIG_DRM_PANEL_SITRONIX_ST7703 is not set
# CONFIG_DRM_PANEL_STARTEK_KD070FHFID015 is not set
# CONFIG_DRM_PANEL_TRULY_NT35597_WQXGA is not set
# CONFIG_DRM_PANEL_VISIONOX_VTDR6130 is not set
# Bridge/encoder chips: HDMI transmitters, DSI-to-LVDS/eDP converters, DP muxes.
# CONFIG_DRM_DISPLAY_CONNECTOR is not set
# CONFIG_DRM_SIMPLE_BRIDGE is not set
# CONFIG_DRM_I2C_NXP_TDA998X is not set
# CONFIG_DRM_I2C_ADV7511 is not set
# CONFIG_DRM_LONTIUM_LT8912B is not set
# CONFIG_DRM_LONTIUM_LT9611 is not set
# CONFIG_DRM_LONTIUM_LT9611UXC is not set
# CONFIG_DRM_ITE_IT6263 is not set
# CONFIG_DRM_ITE_IT66121 is not set
# CONFIG_DRM_PARADE_PS8640 is not set
# CONFIG_DRM_SAMSUNG_DSIM is not set
# CONFIG_DRM_SII902X is not set
# CONFIG_DRM_THINE_THC63LVD1024 is not set
# CONFIG_DRM_TOSHIBA_TC358767 is not set
# CONFIG_DRM_TOSHIBA_TC358768 is not set
# CONFIG_DRM_TI_TFP410 is not set
# CONFIG_DRM_TI_SN65DSI83 is not set
# CONFIG_DRM_TI_SN65DSI86 is not set
# CONFIG_DRM_ANALOGIX_ANX7625 is not set
# CONFIG_DRM_CDNS_DSI is not set
# CONFIG_DRM_CDNS_MHDP8546 is not set
# CONFIG_DRM_NWL_MIPI_DSI is not set
# CONFIG_DRM_FSL_LDB is not set
# CONFIG_DRM_IMX8MP_DW_HDMI_BRIDGE is not set
# CONFIG_DRM_DW_HDMI_AHB_AUDIO is not set
# CONFIG_DRM_DW_HDMI_CEC is not set
# CONFIG_DRM_DW_HDMI_QP_CEC is not set
# Display controllers and GPUs that defconfig turns on and the ARCH_ block does
# not cover (PANTHOR/POWERVR are newer Mali/IMG drivers; the LIMA/PANFROST
# reasoning above applies to them identically — no 3D anywhere in Town OS).
# CONFIG_DRM_PANTHOR is not set
# CONFIG_DRM_POWERVR is not set
# CONFIG_DRM_HDLCD is not set
# CONFIG_DRM_TIDSS is not set
# CONFIG_DRM_MXSFB is not set
# CONFIG_DRM_IMX_LCDIF is not set
# CONFIG_DRM_IMX_DCSS is not set
# CONFIG_DRM_RCAR_DU is not set
# CONFIG_DRM_RZG2L_DU is not set
# CONFIG_DRM_RZG2L_MIPI_DSI is not set
# CONFIG_DRM_ZYNQMP_DPSUB is not set
# NOTE: DRM_SUN6I_DSI and DRM_SUN8I_DW_HDMI are deliberately LEFT ALONE. They
# are sunxi siblings of the display path this build exists to make work, they
# are small, and a dark panel is the one failure this board cannot report.

# =============================================================================
# Networking features nothing in Town OS uses
# =============================================================================
# Traffic shaping/classification: podman's netavark programs nftables, not tc,
# and neither wg-quick nor systemd-networkd installs a qdisc here (pfifo_fast
# stays). DSA is for managed switch silicon; IPVS is a load balancer.
# CONFIG_NET_SCHED is not set
# CONFIG_NET_CLS_ACT is not set
# CONFIG_NET_DSA is not set
# CONFIG_IP_VS is not set
# CONFIG_NETFILTER_XT_MATCH_IPVS is not set
# Kernel-level DHCP/BOOTP is for NFS root; this box runs dhcpcd from the initrd.
# CONFIG_IP_PNP is not set
# CONFIG_HSR is not set
# CONFIG_MACVTAP is not set
# CONFIG_BRIDGE_VLAN_FILTERING is not set
# Ethernet PHY drivers survive `# CONFIG_ETHERNET is not set` because PHYLIB is
# a separate subsystem — but the only wires this box ever sees are USB adapters
# with their PHYs on-die. PHYLIB itself stays (smsc95xx selects it).
# CONFIG_AQUANTIA_PHY is not set
# CONFIG_MICREL_PHY is not set
# CONFIG_MICROSEMI_PHY is not set
# CONFIG_AT803X_PHY is not set
# CONFIG_DP83867_PHY is not set
# CONFIG_DP83869_PHY is not set
# CONFIG_DP83TD510_PHY is not set
# CONFIG_VITESSE_PHY is not set
# CONFIG_MDIO_GPIO is not set
# CONFIG_MDIO_BUS_MUX_MULTIPLEXER is not set
# CONFIG_MDIO_BUS_MUX_MMIOREG is not set
# Qualcomm modem bus (WWAN is already off above), GNSS receivers, IR remotes.
# CONFIG_MHI_BUS_PCI_GENERIC is not set
# CONFIG_MHI_NET is not set
# CONFIG_GNSS is not set
# CONFIG_RC_CORE is not set

# =============================================================================
# Platform glue for other people's boards
# =============================================================================
# Chromebook embedded controllers, Greybus, the Qualcomm PMIC bus and the
# Raspberry Pi 5's southbridge — none arch-gated, none present here.
# CONFIG_CHROME_PLATFORMS is not set
# CONFIG_EC_ACER_ASPIRE1 is not set
# CONFIG_EC_HUAWEI_GAOKUN is not set
# CONFIG_EC_LENOVO_YOGA_C630 is not set
# CONFIG_EC_LENOVO_THINKPAD_T14S is not set
# CONFIG_GREYBUS is not set
# CONFIG_SPMI is not set
# CONFIG_MISC_RP1 is not set
# CONFIG_UACCE is not set
# DMA engines: the H700's is sun6i-dma (kept by ARCH_SUNXI). These are Marvell,
# ARM PrimeCell and Synopsys PCIe eDMA.
# CONFIG_MV_XOR is not set
# CONFIG_MV_XOR_V2 is not set
# CONFIG_PL330_DMA is not set
# CONFIG_DW_EDMA is not set
# PCI stays (QEMU 'virt' carries virtio on it) but the H700 has no PCIe at all,
# so SR-IOV, endpoint mode, AER and hotplug are dead weight on both.
# CONFIG_PCI_IOV is not set
# CONFIG_PCI_PASID is not set
# CONFIG_PCI_ENDPOINT is not set
# CONFIG_PCIEAER is not set
# CONFIG_HOTPLUG_PCI is not set
# CONFIG_PCIE_ALTERA is not set
# CONFIG_SERIO_AMBAKMI is not set

# =============================================================================
# Build/packaging knobs
# =============================================================================
# Debug info is dropped because it triples build time and image size for a kernel
# nobody will run a debugger against, and BTF additionally needs pahole.
#
# MODULES ARE LEFT UNCOMPRESSED ON PURPOSE. Per-module compression needs
# CONFIG_MODULE_COMPRESS first (the ZSTD choice hangs off it), and turning that
# on would make this image bigger, not smaller: /usr/lib/modules is inside the
# gzip squashfs and the initramfs is compressed as a whole, so a pre-compressed
# .ko is incompressible payload in both. The kernel's own help text for the
# option says as much for the initramfs case. A bare CONFIG_MODULE_COMPRESS_ZSTD
# line was a silent no-op regardless.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_WERROR is default-y in arm64 defconfig, and it CANNOT stay on with a
# vendored patch stack: -Wmissing-prototypes and -Wunused-result are on by
# default (scripts/Makefile.warn), and ROCKNIX's patches trip both — their
# adc-keys change adds two non-static functions with no prototype, their OTG fix
# calls regulator_enable() without checking it. With -Werror each of those is a
# dead build, hours in, over a warning upstream never promised to avoid in
# out-of-tree code. ROCKNIX's own H700 config has WERROR unset for the same
# reason; this matches it.
# CONFIG_WERROR is not set
